# UJI Deporte — copy to .env (never commit secrets)

# Cookie signing secret (required for any shared/production host)
SESSION_SECRET=replace-with-a-long-random-string

# Optional override for POST !uji_sports.reservas_usuario.reservas_tipos
# Default is built as: pcursoaca=YYYY&divid=PanelRealizarTiposU&_=&p_mesanyo=YYYYMM
# UJI_RESERVAS_TIPOS_BODY=pcursoaca=2026&divid=PanelRealizarTiposU&_=&p_mesanyo=202610

# Optional override for POST !uji_sports.reservas_usuario.reservas_disponible
# Default: p_fecha=DD/MM/YYYY&divid=PanelRealizarDisponibilidadU&_=
# Placeholders: {date} DD/MM/YYYY, {dateShort} DD/MM/YY, {persona}
# UJI_RESERVAS_DISPONIBLE_BODY=p_fecha={date}&divid=PanelRealizarDisponibilidadU&_=

# Docker / production single-process port (ignored by `pnpm dev` API)
APP_PORT=4321
PORT=4321

# Dev API port — Vite (4321) proxies /api here. Do not set this to 4321.
API_PORT=4322
